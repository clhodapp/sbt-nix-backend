<ivysettings>
  <settings defaultResolver="main"/>
  <resolvers>
    <chain name="main" returnFirst="true">
      <ibiblio name="central" m2compatible="true" root="https://repo1.maven.org/maven2/"/>
      <url name="sbt-archive">
        <ivy pattern="https://scala.jfrog.io/artifactory/api/download/ivy-releases/[organisation]/[module]/[revision]/ivys/ivy.xml"/>
        <artifact pattern="https://scala.jfrog.io/artifactory/api/download/ivy-releases/[organisation]/[module]/[revision]/[type]s/[artifact](-[classifier]).[ext]"/>
      </url>
    </chain>
  </resolvers>
</ivysettings>
